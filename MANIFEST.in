include LICENSE NOTICE.md README.md CHANGELOG.md INTEGRATION-CONTRACT.md SECURITY.md VALIDATION.md
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
prune .venv
prune .consumer-venv
prune dist
prune build
prune .pytest_cache
prune .git
recursive-exclude * __pycache__ *.py[cod] *.sqlite *.sqlite3 *.db .DS_Store
